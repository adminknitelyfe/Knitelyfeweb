{
  // Knite Lyfe website — deployed to Cloudflare Workers.
  //
  // The site is nine static HTML pages, served from ./site by Workers Static
  // Assets. The Worker in ./worker exists only to answer the form endpoints
  // (/api/waitlist, /api/campus, /api/signups); every other request falls
  // through to the static assets via the ASSETS binding, so there is still one
  // deploy and one domain.
  //
  // Deploy:  npx wrangler deploy
  // Preview: npx wrangler versions upload
  // Local:   npx wrangler dev        (uses a local SQLite file, not production)

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knitelyfeweb",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-27",

  // Custom domains. Declaring them here means Cloudflare manages the DNS
  // records for them — adding knitelyfe.com replaced the A record that used to
  // point at the WordPress install on Northwest Registered Agent
  // (66.223.49.89). See ROLLBACK-dns.md to undo that.
  //
  // www is included because it was its own A record pointing at Northwest, not
  // a redirect rule — leaving it alone would have left www serving the old
  // host after the apex moved.
  //
  // The *.knitelyfe.com wildcard still points at Northwest and is deliberately
  // left in place: more specific records win, so it does not affect these, and
  // it is what makes old.knitelyfe.com work if WordPress is ever restored.
  "routes": [
    { "pattern": "knitelyfe.com", "custom_domain": true },
    { "pattern": "www.knitelyfe.com", "custom_domain": true },
    { "pattern": "v1.knitelyfe.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./site",

    // Named so the Worker can hand non-API requests straight to the assets.
    "binding": "ASSETS",

    // "auto-trailing-slash" lets /safety resolve to /safety.html, so the clean
    // URL and the .html URL both work. Every internal link on the site uses the
    // .html form, so this only adds tolerance rather than changing behaviour.
    "html_handling": "auto-trailing-slash",

    // The site has no 404 page yet. "none" returns Cloudflare's default 404
    // rather than silently serving index.html for a mistyped path, which would
    // make broken links invisible. Switch to "404-page" once site/404.html
    // exists.
    "not_found_handling": "none"
  },

  // Form submissions. The database_id is an identifier, not a credential —
  // it is safe in a public repo. Access is controlled by the account the
  // Worker is deployed under, not by knowing this string.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knitelyfe-signups",
      "database_id": "e64d8b94-c257-4589-b90a-f244e7e30711",
      "migrations_dir": "migrations"
    }
  ],

  // Secrets are NOT set here — this file is in a public repo. Set them with:
  //   npx wrangler secret put ADMIN_TOKEN     (guards the export endpoint)
  //   npx wrangler secret put IP_SALT         (salts the stored IP hashes)

  "observability": {
    "enabled": true
  }
}
